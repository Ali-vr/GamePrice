# =========================================
# GamePrice - Variables de entorno (ejemplo)
# Copiar a .env y completar con valores reales.
# NUNCA subir el archivo .env real al repositorio.
# =========================================

# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- Backend / FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=gameprice
POSTGRES_PASSWORD=gameprice
POSTGRES_DB=gameprice
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gameprice:gameprice@postgres:5432/gameprice

# --- Redis / Celery (se activan a partir de Fase 15) ---
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Frontend / Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Integraciones externas (a completar cuando se implementen) ---
# STEAM_API_KEY=
# EXCHANGE_RATE_API_KEY=
